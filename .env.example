# .env.example
# Copy this to .env and fill in your actual values

# Gemini API Configuration (via OpenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3-flash-preview

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/review_agent.log

# Generation Settings
DETECTION_TEMPERATURE=0.3
DETECTION_MAX_TOKENS=2048
EXPLANATION_TEMPERATURE=0.4
EXPLANATION_MAX_TOKENS=1024
VERIFICATION_TEMPERATURE=0.2
VERIFICATION_MAX_TOKENS=1024

# Features
ENABLE_VERIFICATION=true
ENABLE_QUALITY_CHECKS=true
MAX_ISSUES_PER_RUN=20
MAX_CODE_LENGTH=10000

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=10